<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd">
	<vertical preferred-width="100">
		<!-- Header -->
		<horizontal>
			<text text="Select a Configuration to Play" font-size="4"/>
		</horizontal>

		<!-- Select Pre-Configured PlayMode List -->
    <custom-list id="SelectModeList" visible-cells="7" cell-size="7" list-width="100" select-cell="OnModeClicked" stick-scrolling="true" show-scrollbar="true">
      <horizontal pref-width="100" child-expand-width="false">
        <horizontal pad-right="1" child-expand-width="false">
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~PlayModeHint00" source="~PlayModeIcon00" />
        </horizontal>
        <horizontal pad-right="1" child-expand-width="true">
          <text text="~Mode" hover-hint="~Mode" color="~SelectedColor" overflow-mode="Ellipsis" align="MidlineLeft" font-size="4" />
        </horizontal>

        <horizontal pref-height="6" pad-left="1" pad-right="1" child-expand-width="false" bg="round-rect-panel">
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~PlayModeHint01" source="~PlayModeIcon01" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~PlayModeHint02" source="~PlayModeIcon02" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~PlayModeHint03" source="~PlayModeIcon03" />
        </horizontal>

        <horizontal pref-height="6" pad-left="1" pad-right="1" child-expand-width="false" bg="round-rect-panel">
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" source="~TrackerIcon00" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" source="~TrackerIcon01" />
        </horizontal>

        <horizontal pref-height="6" pad-left="1" pad-right="1" child-expand-width="false" bg="round-rect-panel">
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~GameModifierHint00" source="~GameModifierIcon00" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~GameModifierHint01" source="~GameModifierIcon01" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~GameModifierHint02" source="~GameModifierIcon02" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~GameModifierHint03" source="~GameModifierIcon03" />
          <img preserve-aspect="true" pref-width="5" pref-height="5" img-color="~SelectedColor" hover-hint="~GameModifierHint04" source="~GameModifierIcon04" />
        </horizontal>
      </horizontal>
    </custom-list>
	</vertical>
</bg>